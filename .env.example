# am-shortlink-service — biến môi trường (local). Secret thật lấy từ Vault qua <TÊN>_FILE.
APP_ENV=local
LOG_LEVEL=info

# DÙNG CHUNG MongoDB với Portal (am-shortlink-sale-portal/deploy/docker-compose.yml → cổng 27018)
MONGODB_URI=mongodb://localhost:27018/?directConnection=true
MONGODB_DB_CORE=am_shortlink
MONGODB_DB_REPORT=am_shortlink_report

# Redis của Service (tuỳ chọn; trống = chỉ cache RAM, quota đếm trên MongoDB)
REDIS_ADDR=
REDIS_KEY_PREFIX=am-shortlink:

# Kafka (tuỳ chọn). Trống → CLICK_SINK=direct: redirect/api tự ghi thống kê trong tiến trình
KAFKA_BROKERS=
KAFKA_CLICK_TOPIC=am-shortlink-clicks
KAFKA_LINK_TOPIC=am-shortlink-links
KAFKA_GROUP_ID=am-shortlink-consumer
# CLICK_SINK=direct

# Redirect
REDIRECT_HTTP_ADDR=:8090
REDIRECT_LEGACY_ROOT=true

# API (tương thích PHP): short URL = APP_PROTOCOL + APP_HOST + /prefix/code
API_HTTP_ADDR=:8091
APP_PROTOCOL=https://
APP_HOST=fpt.vn
DEFAULT_PREFIX=sale
DEFAULT_PREFIX_V3=lm
PSEUDO_RANDOM_KEY_LENGTH=6
API_KEY_LENGTH=15
ALLOW_IP=
RATE_LIMIT_PER_SECOND=0

# Consumer
CONSUMER_HTTP_ADDR=:8092
SUSPICIOUS_THRESHOLD=20
SNAPSHOT_INTERVAL=30m

# Phải TRÙNG với Portal (tra cứu tham số pii=hash)
PII_HASH_SALT=local-dev-pii-salt-0123456789

# TrackingApi / FMI (thay user hard-code `lehongan` của hệ cũ)
TRACKING_USERS=
TRACKING_BASE_URL=
TRACKING_AUTH_URL=
TRACKING_CLIENT_ID=
TRACKING_CLIENT_SECRET=
FMI_USERS=
FMI_BASE_URL=
FMI_API_KEY=
